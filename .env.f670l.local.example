# Copy this file to .env.f670l.local and fill in your router credentials.
# The real .env.f670l.local file is gitignored.

ZTE_HOST=192.168.1.1
ZTE_USERNAME=
ZTE_PASSWORD=
ZTE_MODEL=F670L

# Optional: auto | http | https
ZTE_SCHEME=auto

# Optional booleans: true/false
ZTE_VERIFY_SSL=false
ZTE_QUERY_WAN_STATUS=true
ZTE_QUERY_ROUTER_DETAILS=true
ZTE_MESH_TOPOLOGY=false